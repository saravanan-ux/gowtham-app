<!DOCTYPE html>
<html>
<head>
  <title>Provider Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .card { border: 1px solid #e9ecef; border-radius: 8px; transition: box-shadow 0.2s; }
    .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .notif-btn { position: relative; display: inline-block; }
    .notif-badge {
      position: absolute; top: -6px; right: -8px;
      background: #dc3545; color: white; border-radius: 50%;
      font-size: 0.65rem; width: 18px; height: 18px;
      display: flex; align-items: center;
      justify-content: center; font-weight: bold;
    }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-person-badge-fill text-warning me-2"></i>
      Provider Dashboard
    </span>
    <div class="d-flex align-items-center gap-3">
      <a href="/notifications" class="btn btn-outline-light btn-sm notif-btn">
        <i class="bi bi-bell-fill"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/logout" class="btn btn-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </a>
    </div>
  </nav>

  <div class="container" style="max-width:900px;">

    <h4 class="fw-bold mb-4">
      <i class="bi bi-speedometer2 me-2 text-primary"></i>Provider Dashboard
    </h4>

    <div class="row">

      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="fw-bold">
              <i class="bi bi-bar-chart-fill me-2 text-success"></i>Analytics
            </h5>
            <p class="text-muted">View your appointment and performance analytics.</p>
            <a href="/provider-analytics" class="btn btn-success mt-auto">
              <i class="bi bi-graph-up me-1"></i>View My Analytics
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="fw-bold">
              <i class="bi bi-clock-fill me-2 text-primary"></i>Working Hours
            </h5>
            <p class="text-muted">Configure and update your availability schedule.</p>
            <a href="/provider-working-hours" class="btn btn-primary mt-auto">
              <i class="bi bi-calendar-plus me-1"></i>Set Working Hours
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>