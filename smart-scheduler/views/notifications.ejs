<!DOCTYPE html>
<html>
<head>
  <title>Notifications</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .notification-card { border-left: 5px solid #0d6efd; transition: all 0.2s ease; }
    .notification-card.SUCCESS { border-left-color: #198754; }
    .notification-card.WARNING { border-left-color: #ffc107; }
    .notification-card.DANGER  { border-left-color: #dc3545; }
    .notification-card.INFO    { border-left-color: #0dcaf0; }
    .notification-card:hover   { transform: translateX(4px); box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .time-badge { font-size: 0.75rem; color: #6c757d; }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-bell-fill text-warning me-2"></i>Notifications
    </span>
    <a href="javascript:history.back()" class="btn btn-outline-light btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </nav>

  <div class="container py-2" style="max-width:780px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="mb-0 fw-bold">
        <i class="bi bi-bell me-2 text-primary"></i>All Notifications
      </h4>
      <span class="badge bg-secondary">
        <%= notifications.length %> total
      </span>
    </div>

    <% if (notifications.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-bell-slash display-1 text-muted"></i>
        <p class="mt-3 text-muted fs-5">No notifications yet.</p>
      </div>
    <% } else { %>
      <% notifications.forEach(n => { %>
        <div class="card mb-3 notification-card <%= n.type %>">
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <% if (n.type === 'SUCCESS') { %>
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                <% } else if (n.type === 'WARNING') { %>
                  <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                <% } else if (n.type === 'DANGER') { %>
                  <i class="bi bi-x-circle-fill text-danger me-2"></i>
                <% } else { %>
                  <i class="bi bi-info-circle-fill text-info me-2"></i>
                <% } %>
                <strong><%= n.title %></strong>
              </div>
              <span class="time-badge">
                <i class="bi bi-clock me-1"></i>
                <%= new Date(n.created_at).toLocaleString() %>
              </span>
            </div>
            <p class="mb-0 mt-2 ms-4 text-muted"><%= n.message %></p>
          </div>
        </div>
      <% }) %>
    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>