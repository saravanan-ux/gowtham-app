<!DOCTYPE html>
<html>
<head>
  <title>Select Date</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .date-card {
      border: 1px solid #e9ecef; border-radius: 8px;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .date-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); transform: translateY(-3px); }
    .notif-btn { position: relative; display: inline-block; }
    .notif-badge {
      position: absolute; top: -6px; right: -8px;
      background: #dc3545; color: white; border-radius: 50%;
      font-size: 0.65rem; width: 18px; height: 18px;
      display: flex; align-items: center;
      justify-content: center; font-weight: bold;
    }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-calendar3 text-warning me-2"></i>Book Appointment
    </span>
    <div class="d-flex align-items-center gap-3">
      <a href="/notifications" class="btn btn-outline-light btn-sm notif-btn">
        <i class="bi bi-bell-fill"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/my-appointments" class="btn btn-outline-light btn-sm">
        <i class="bi bi-calendar-check me-1"></i>My Appointments
      </a>
      <a href="/logout" class="btn btn-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </a>
    </div>
  </nav>

  <div class="container" style="max-width:1100px;">

    <h4 class="fw-bold mb-4">
      <i class="bi bi-calendar-date me-2 text-primary"></i>
      Select an Appointment Date
    </h4>

    <% if (dates.length === 0) { %>
      <div class="text-center py-5">
        <i class="bi bi-calendar-x display-1 text-muted"></i>
        <p class="mt-3 text-muted fs-5">No available dates at the moment.</p>
      </div>
    <% } %>

    <div class="row">
      <% dates.forEach(date => { %>
        <div class="col-md-3 mb-4">
          <div class="card date-card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <i class="bi bi-calendar2-check display-6 text-primary mb-2"></i>
                <div class="fw-semibold mt-2">
                  <%= new Date(date.available_date).toDateString() %>
                </div>
              </div>
              <a href="/booking/<%= date.available_date %>"
                class="btn btn-success btn-sm mt-3">
                <i class="bi bi-arrow-right-circle me-1"></i>Select Date
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>