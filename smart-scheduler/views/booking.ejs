<!DOCTYPE html>
<html>
<head>
  <title>Book Appointment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .slot-card {
      border: 1px solid #e9ecef; border-radius: 8px;
      transition: box-shadow 0.2s;
    }
    .slot-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .notif-btn { position: relative; display: inline-block; }
    .notif-badge {
      position: absolute; top: -6px; right: -8px;
      background: #dc3545; color: white; border-radius: 50%;
      font-size: 0.65rem; width: 18px; height: 18px;
      display: flex; align-items: center;
      justify-content: center; font-weight: bold;
    }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-calendar-plus text-warning me-2"></i>Book Appointment
    </span>
    <div class="d-flex align-items-center gap-3">
      <a href="/notifications" class="btn btn-outline-light btn-sm notif-btn">
        <i class="bi bi-bell-fill"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/my-appointments" class="btn btn-outline-light btn-sm">
        <i class="bi bi-calendar-check me-1"></i>My Appointments
      </a>
      <a href="/booking" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
      <a href="/logout" class="btn btn-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </a>
    </div>
  </nav>

  <div class="container" style="max-width:1000px;">

    <h4 class="fw-bold mb-4">
      <i class="bi bi-calendar-event me-2 text-primary"></i>
      Booking for: <%= selectedDate %>
    </h4>

    <!-- Doctor Dropdown -->
    <div class="card mb-4 p-3">
      <form method="GET" action="/booking/<%= selectedDate %>">
        <label class="form-label fw-semibold">
          <i class="bi bi-person-badge me-1 text-primary"></i>Select Doctor
        </label>
        <select name="provider_id" class="form-select"
          onchange="this.form.submit()" required>
          <option value="">-- Choose Doctor --</option>
          <% doctors.forEach(doc => { %>
            <option value="<%= doc.id %>"
              <%= selectedProvider == doc.id ? "selected" : "" %>>
              <%= doc.email %> (<%= doc.specialization %>)
            </option>
          <% }) %>
        </select>
      </form>
    </div>

    <!-- No Slots -->
    <% if (selectedProvider && slots.length === 0) { %>
      <div class="text-center py-4">
        <i class="bi bi-calendar-x display-4 text-muted"></i>
        <p class="mt-3 text-muted">No slots available for this doctor.</p>
      </div>
    <% } %>

    <!-- Slots -->
    <% slots.forEach(slot => { %>
      <div class="card slot-card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <i class="bi bi-clock me-2 text-primary"></i>
            <strong>
              <%= new Date(slot.start_time).toLocaleTimeString() %>
              &nbsp;—&nbsp;
              <%= new Date(slot.end_time).toLocaleTimeString() %>
            </strong>
          </div>
          <div>
            <% if (!slot.is_booked) { %>
              <form method="POST" action="/book-slot" class="d-inline">
                <input type="hidden" name="slot_id" value="<%= slot.slot_id %>">
                <button class="btn btn-success btn-sm">
                  <i class="bi bi-calendar-check me-1"></i>Book
                </button>
              </form>
            <% } else if (slot.booked_by == userId) { %>
              <button class="btn btn-outline-primary btn-sm" disabled>
                <i class="bi bi-check-circle me-1"></i>Booked by You
              </button>
            <% } else { %>
              <form method="POST" action="/book-slot" class="d-inline">
                <input type="hidden" name="slot_id" value="<%= slot.slot_id %>">
                <button class="btn btn-outline-warning btn-sm">
                  <i class="bi bi-hourglass-split me-1"></i>Join Waitlist
                </button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>