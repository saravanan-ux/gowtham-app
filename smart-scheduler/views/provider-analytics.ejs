<!DOCTYPE html>
<html>
<head>
  <title>Provider Analytics</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .card-hover:hover { transform: translateY(-4px); transition: 0.2s; box-shadow: 0 6px 20px rgba(0,0,0,0.1); }
    .notif-btn { position: relative; display: inline-block; }
    .notif-badge {
      position: absolute; top: -6px; right: -8px;
      background: #dc3545; color: white; border-radius: 50%;
      font-size: 0.65rem; width: 18px; height: 18px;
      display: flex; align-items: center;
      justify-content: center; font-weight: bold;
    }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-graph-up-arrow text-warning me-2"></i>
      Provider Analytics
    </span>
    <div class="d-flex align-items-center gap-3">
      <a href="/notifications" class="btn btn-outline-light btn-sm notif-btn">
        <i class="bi bi-bell-fill"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/provider-dashboard" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
      <a href="/logout" class="btn btn-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </a>
    </div>
  </nav>

  <div class="container">

    <h4 class="fw-bold mb-1">
      <i class="bi bi-speedometer2 me-2 text-primary"></i>
      Provider Analytics Dashboard
    </h4>
    <p class="text-muted mb-4">Monitor performance, bookings, and trends</p>

    <!-- KPI CARDS -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="card shadow-sm text-center card-hover p-3">
          <i class="bi bi-calendar3 display-6 text-primary"></i>
          <h6 class="text-muted mt-2">Total Slots</h6>
          <h3 class="fw-bold text-primary"><%= totalSlots %></h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm text-center card-hover p-3">
          <i class="bi bi-check-circle display-6 text-success"></i>
          <h6 class="text-muted mt-2">Total Booked</h6>
          <h3 class="fw-bold text-success"><%= totalBooked %></h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm text-center card-hover p-3">
          <i class="bi bi-x-circle display-6 text-danger"></i>
          <h6 class="text-muted mt-2">Total Cancelled</h6>
          <h3 class="fw-bold text-danger"><%= totalCancelled %></h3>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card shadow-sm text-center card-hover p-3">
          <i class="bi bi-speedometer2 display-6 text-warning"></i>
          <h6 class="text-muted mt-2">Utilization</h6>
          <h3 class="fw-bold text-warning"><%= (utilization * 100).toFixed(1) %>%</h3>
        </div>
      </div>
    </div>

    <!-- FILTER -->
    <div class="card shadow-sm mb-4 p-4">
      <h5 class="mb-3">
        <i class="bi bi-funnel me-2"></i>Filter Appointments by Date
      </h5>
      <form method="GET" action="/provider-analytics" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Select Date</label>
          <select name="date" class="form-select" required>
            <option value="">Choose Date</option>
            <% dates.forEach(d => { %>
              <option value="<%= d.appointment_date.toLocaleDateString('en-CA') %>"
                <%= selectedDate == d.appointment_date.toISOString().split('T')[0] ? "selected" : "" %>>
                <%= new Date(d.appointment_date).toDateString() %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <button class="btn btn-primary w-100">
            <i class="bi bi-search me-1"></i>Filter
          </button>
        </div>
      </form>
    </div>

    <!-- APPOINTMENTS TABLE -->
    <div class="card shadow-sm mb-5 p-4">
      <h5 class="mb-3">
        <i class="bi bi-clock-history me-2"></i>Appointment Details
      </h5>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th>#</th><th>Client</th><th>Date</th>
              <th>Start</th><th>End</th><th>Status</th><th>Booked At</th>
            </tr>
          </thead>
          <tbody>
            <% if (!appointments || appointments.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">
                  <i class="bi bi-calendar-x me-2"></i>
                  No appointments found for selected date
                </td>
              </tr>
            <% } %>
            <% appointments.forEach((app, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><strong><%= app.client_email %></strong></td>
                <td><%= new Date(app.start_time).toDateString() %></td>
                <td>
                  <%= new Date(app.start_time).toLocaleTimeString([],
                    {hour:'2-digit', minute:'2-digit'}) %>
                </td>
                <td>
                  <%= new Date(app.end_time).toLocaleTimeString([],
                    {hour:'2-digit', minute:'2-digit'}) %>
                </td>
                <td>
                  <% if (app.status === 'BOOKED') { %>
                    <span class="badge bg-success">BOOKED</span>
                  <% } else { %>
                    <span class="badge bg-danger">CANCELLED</span>
                  <% } %>
                </td>
                <td class="text-muted">
                  <%= new Date(app.created_at).toLocaleString() %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>