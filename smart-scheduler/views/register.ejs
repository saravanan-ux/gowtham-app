<!DOCTYPE html>
<html>
<head>
  <title>Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #e9ecef, #70757d);
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .register-card {
      width: 100%;
      max-width: 420px;
      padding: 40px;
      border-radius: 15px;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }
    .register-title { text-align: center; margin-bottom: 30px; font-weight: 700; }
    .btn-success { width: 100%; padding: 10px; font-weight: 500; }
    .login-text { text-align: center; margin-top: 20px; }
    .login-text a { text-decoration: none; font-weight: 500; }
    .login-text a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <div class="register-card">

    <h2 class="register-title">
      <i class="bi bi-person-plus-fill text-success me-2"></i>
      Create Account
    </h2>

    <form method="POST" action="/register">

      <div class="mb-3">
        <label class="form-label fw-semibold">
          <i class="bi bi-person me-1"></i>Full Name
        </label>
        <input type="text" name="name"
          class="form-control" placeholder="Enter full name" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">
          <i class="bi bi-envelope me-1"></i>Email
        </label>
        <input type="email" name="email"
          class="form-control" placeholder="Enter email" required>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">
          <i class="bi bi-lock me-1"></i>Password
        </label>
        <input type="password" name="password"
          class="form-control" placeholder="Enter password" required>
      </div>

      <button class="btn btn-success">
        <i class="bi bi-person-check me-1"></i>Register
      </button>

    </form>

    <div class="login-text">
      <p class="text-muted mt-3">
        Already have an account? <a href="/login">Login here</a>
      </p>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>