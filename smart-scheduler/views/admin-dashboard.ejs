<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body { background-color: #f4f6f9; font-family: Arial, sans-serif; }
    .card {
      border: 1px solid #e9ecef;
      border-radius: 8px;
      transition: box-shadow 0.2s ease;
    }
    .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .notif-btn { position: relative; display: inline-block; }
    .notif-badge {
      position: absolute; top: -6px; right: -8px;
      background: #dc3545; color: white; border-radius: 50%;
      font-size: 0.65rem; width: 18px; height: 18px;
      display: flex; align-items: center;
      justify-content: center; font-weight: bold;
    }
  </style>
</head>
<body>

  <%- include('partials/_flash') %>

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark px-4 mb-4">
    <span class="navbar-brand fw-bold">
      <i class="bi bi-shield-lock-fill text-warning me-2"></i>
      Admin Dashboard
    </span>
    <div class="d-flex align-items-center gap-3">
      <a href="/notifications" class="btn btn-outline-light btn-sm notif-btn">
        <i class="bi bi-bell-fill"></i>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="notif-badge"><%= unreadCount %></span>
        <% } %>
      </a>
      <a href="/logout" class="btn btn-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i>Logout
      </a>
    </div>
  </nav>

  <div class="container" style="max-width:1000px;">

    <h4 class="fw-bold mb-4">
      <i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Dashboard
    </h4>

    <div class="row">

      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="fw-bold">
              <i class="bi bi-person-badge-fill me-2 text-primary"></i>
              Doctor Management
            </h5>
            <p class="text-muted">Create and manage doctors.</p>
            <a href="/admin/providers" class="btn btn-primary mt-auto">
              <i class="bi bi-people me-1"></i>Manage Doctors
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="fw-bold">
              <i class="bi bi-building-fill me-2 text-warning"></i>
              Resource Management
            </h5>
            <p class="text-muted">Create and manage system resources.</p>
            <a href="/admin/resources" class="btn btn-warning mt-auto">
              <i class="bi bi-box me-1"></i>Manage Resources
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h5 class="fw-bold">
              <i class="bi bi-bar-chart-fill me-2 text-success"></i>
              System Analytics
            </h5>
            <p class="text-muted">View overall system performance.</p>
            <a href="/admin-analytics" class="btn btn-success mt-auto">
              <i class="bi bi-graph-up me-1"></i>View Analytics
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- RESOURCE WAITLIST -->
    <div class="mt-4">
      <h5 class="fw-bold mb-3">
        <i class="bi bi-hourglass-split me-2 text-warning"></i>
        Resource Waiting List (Upcoming)
      </h5>

      <% if (waitlist && waitlist.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
              <tr>
                <th>Provider</th>
                <th>Resource</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% waitlist.forEach(item => { %>
                <tr>
                  <td><%= item.provider_name %></td>
                  <td><%= item.resource_name %></td>
                  <td><%= new Date(item.requested_start_time).toLocaleString() %></td>
                  <td><%= new Date(item.requested_end_time).toLocaleString() %></td>
                  <td>
                    <span class="badge bg-warning text-dark">
                      <i class="bi bi-hourglass me-1"></i>Waiting
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-success">
          <i class="bi bi-check-circle-fill me-2"></i>
          No upcoming resource waitlist requests 🎉
        </div>
      <% } %>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>